{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UBAG load workload manifest",
  "description": "One recorded workload class for tests/load (text, attachment, audio-upload, mixed, voice). Validated by tests/load/workloads.mjs (a small built-in checker; no ajv dependency) plus cross-field rules: mix weights sum to 100, ranges ordered, ladder ascending, and the audio-only fields (synthetic, route, prompt, target_requirements, fixture) are required for kind audio-upload and forbidden otherwise.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "kind", "description", "harness_support", "provider_scenario", "mix", "think_time_ms", "ladder_steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "kind": { "enum": ["text", "attachment", "audio-upload", "mixed", "voice"] },
    "description": { "type": "string", "minLength": 1 },
    "harness_support": {
      "description": "implemented: tests/load/acceptance.mjs or tests/load/ladder.mjs generates this traffic today. planned: the manifest records the intended workload; no generator exists yet.",
      "enum": ["implemented", "planned"]
    },
    "provider_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "command_type", "live_provider", "requires_live_media"],
      "properties": {
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
        "command_type": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{0,59}$" },
        "live_provider": { "type": "boolean" },
        "requires_live_media": { "type": "boolean" }
      }
    },
    "mix": {
      "description": "Traffic classes. Weights are relative shares and must sum to 100.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "weight", "payload_bytes"],
        "properties": {
          "kind": { "enum": ["text", "attachment", "audio_upload", "voice_session"] },
          "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
          "payload_bytes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": { "min": { "type": "integer", "minimum": 0, "maximum": 33554432 }, "max": { "type": "integer", "minimum": 0, "maximum": 33554432 } }
          },
          "session_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
        }
      }
    },
    "think_time_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": { "min": { "type": "integer", "minimum": 0, "maximum": 3600000 }, "max": { "type": "integer", "minimum": 0, "maximum": 3600000 } }
    },
    "ladder_steps": {
      "description": "Concurrent-client counts for the step runs, strictly ascending.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1, "maximum": 1000 }
    },
    "synthetic": { "const": true },
    "route": { "enum": ["native_multipart"] },
    "prompt": { "type": "string", "minLength": 1 },
    "target_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment_kinds", "content_types", "suggested_targets"],
      "properties": {
        "attachment_kinds": { "type": "array", "minItems": 1, "items": { "enum": ["audio", "voice"] } },
        "content_types": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^audio/[a-z0-9.+-]+$" } },
        "suggested_targets": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "attachment_kind", "content_type", "sample_rate_hz", "channels", "bits_per_sample", "max_bytes", "default_profile", "profiles"],
      "properties": {
        "generator": { "const": "synthetic-wav" },
        "attachment_kind": { "enum": ["audio", "voice"] },
        "content_type": { "type": "string", "pattern": "^audio/[a-z0-9.+-]+$" },
        "sample_rate_hz": { "type": "integer", "minimum": 8000, "maximum": 48000 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 2 },
        "bits_per_sample": { "const": 16 },
        "max_bytes": { "type": "integer", "minimum": 1024, "maximum": 33554432 },
        "default_profile": { "type": "string", "minLength": 1 },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["duration_s"],
            "properties": { "duration_s": { "type": "integer", "minimum": 1, "maximum": 3600 } }
          }
        }
      }
    }
  }
}
