{
  "title": "Fleet manager unreachable",
  "description": "Makes the fleet manager unreachable for the allocation poller. Expected: attempts already placed keep renewing and finish on their helpers; no new grants, increases or placements are made, so new jobs run on the local runner; nothing is failed because the manager is down. The attempt reconciler (P4.18) does not consult the manager either: a gateway restarted during the outage still settles an already-placed attempt from the ledger and the node store's last accepted state, and a job whose earlier attempt submitted is never sent to the local runner.",
  "tags": [
    "helper",
    "fleet",
    "manager",
    "degraded"
  ],
  "status": "definition_only",
  "requires": [
    "UBAG_HELPER_NODES",
    "UBAG_HELPER_PLANE",
    "UBAG_HELPER_DISPATCH",
    "UBAG_EXECUTOR_ATTEMPTS",
    "a placer or manager adaptor wired as the HelperPicker (P4.17)",
    "two Helper Nodes (helper_a, helper_b) on a lab host that is not the shared VPS"
  ],
  "covered_by": [
    "TestRemoteManagerDownKeepsInFlightAttemptsAndGrantsNothingNew",
    "TestRemoteFallsBackToTheLocalRunnerWhenNothingIsPlaced",
    "TestReconcileManagerDownStillSettlesAnAlreadyPlacedAttempt",
    "TestReconcileGateManagerDownRunsAnUnsubmittedJobLocallyButNeverASubmittedOne"
  ],
  "configuration": {
    "helper_a_container": {
      "type": "env",
      "key": "UBAG_CHAOS_HELPER_A_CONTAINER"
    },
    "helper_net": {
      "type": "env",
      "key": "UBAG_CHAOS_HELPER_NET"
    },
    "manager_container": {
      "type": "env",
      "key": "UBAG_CHAOS_MANAGER_CONTAINER"
    },
    "manager_net": {
      "type": "env",
      "key": "UBAG_CHAOS_MANAGER_NET"
    }
  },
  "steady-states": {
    "before": {
      "title": "Gateway is ready before the fault",
      "probes": [
        {
          "type": "probe",
          "name": "gateway-ready",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${gateway_url}/v1/ready",
            "timeout": 5
          }
        }
      ]
    },
    "after": {
      "title": "Gateway is ready after the fault and recovery",
      "probes": [
        {
          "type": "probe",
          "name": "gateway-ready",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${gateway_url}/v1/ready",
            "timeout": 5
          }
        }
      ]
    }
  },
  "method": [
    {
      "type": "action",
      "name": "block-the-fleet-manager",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "network disconnect ${manager_net} ${manager_container}"
      }
    },
    {
      "type": "action",
      "name": "hold-for-180s",
      "provider": {
        "type": "process",
        "path": "sleep",
        "arguments": "180"
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "unblock-the-fleet-manager",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "network connect ${manager_net} ${manager_container}"
      }
    }
  ]
}
