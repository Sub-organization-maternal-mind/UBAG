{
  "title": "A superseded helper keeps writing",
  "description": "Pauses the helper long enough for its attempt lease to lapse and be superseded by a new attempt on another node, then resumes it so it sends events under the old generation. Expected: every late write is rejected by the ledger (UBAG-WORKER-NODE-FENCED-005, audited as attempt.fenced_rejected), the job holds only the successor attempt's events, and the primary never cancels the successor's helper work on behalf of the stale holder.",
  "tags": [
    "helper",
    "fleet",
    "fencing",
    "generation"
  ],
  "status": "definition_only",
  "requires": [
    "UBAG_HELPER_NODES",
    "UBAG_HELPER_PLANE",
    "UBAG_HELPER_DISPATCH",
    "UBAG_EXECUTOR_ATTEMPTS",
    "a placer or manager adaptor wired as the HelperPicker (P4.17)",
    "two Helper Nodes (helper_a, helper_b) on a lab host that is not the shared VPS"
  ],
  "covered_by": [
    "TestRemoteSupersededLeaseStopsWithoutWritingAnything",
    "TestRemoteStaleEventGenerationIsRejectedTheJobUntouchedAndAudited",
    "TestRemoteDuplicateCompletionIsANoOp"
  ],
  "configuration": {
    "helper_a_container": {
      "type": "env",
      "key": "UBAG_CHAOS_HELPER_A_CONTAINER"
    },
    "helper_net": {
      "type": "env",
      "key": "UBAG_CHAOS_HELPER_NET"
    }
  },
  "steady-states": {
    "before": {
      "title": "Gateway is ready before the fault",
      "probes": [
        {
          "type": "probe",
          "name": "gateway-ready",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${gateway_url}/v1/ready",
            "timeout": 5
          }
        }
      ]
    },
    "after": {
      "title": "Gateway is ready after the fault and recovery",
      "probes": [
        {
          "type": "probe",
          "name": "gateway-ready",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${gateway_url}/v1/ready",
            "timeout": 5
          }
        }
      ]
    }
  },
  "method": [
    {
      "type": "action",
      "name": "pause-helper-a",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "pause ${helper_a_container}"
      }
    },
    {
      "type": "action",
      "name": "wait-for-reassignment",
      "provider": {
        "type": "process",
        "path": "sleep",
        "arguments": "200"
      }
    },
    {
      "type": "action",
      "name": "resume-helper-a",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "unpause ${helper_a_container}"
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "ensure-helper-a-running",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "unpause ${helper_a_container}"
      }
    }
  ]
}
