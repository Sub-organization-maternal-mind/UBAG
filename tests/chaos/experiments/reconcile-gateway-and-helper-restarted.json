{
  "title": "Gateway and helper both restarted after the prompt is submitted",
  "description": "Kills the gateway and helper_a after PROMPT_SUBMITTED was committed, then starts both. The restarted helper has no record of the attempt. Expected: the reconciler's InspectAttempt answers UNKNOWN, the job is failed closed (failed_terminal with submitted=true and reconcile_required=true, reason attempt_reconcile_helper_no_record), its queue lease fails without a retry, and the job is never run again: the ledger refuses a successor attempt, the helper receives no RunAttempt for the job and the local runner does not run it. ubag_helper_reconcile_total{action=\"fail_closed\",reason=\"helper_no_record\"} increases and UBAGHelperReconcileFailedClosed fires.",
  "tags": [
    "helper",
    "fleet",
    "reconcile",
    "gateway-restart",
    "submission-boundary"
  ],
  "status": "definition_only",
  "requires": [
    "UBAG_HELPER_NODES",
    "UBAG_HELPER_PLANE",
    "UBAG_HELPER_DISPATCH",
    "UBAG_EXECUTOR_ATTEMPTS",
    "a placer or manager adaptor wired as the HelperPicker (P4.17)",
    "two Helper Nodes (helper_a, helper_b) on a lab host that is not the shared VPS"
  ],
  "covered_by": [
    "TestReconcileGateFailsClosedWhenTheHelperForgotASubmittedAttempt",
    "TestReconcileRealHelperThatForgotTheAttemptFailsClosed",
    "TestReconcileGateWaitsWhileTheHelperIsUnreachableThenFailsClosedAfterTheWindow",
    "TestReconcileLostAfterSubmissionNeverRunsAndTheLedgerAgrees"
  ],
  "configuration": {
    "gateway_container": {
      "type": "env",
      "key": "UBAG_CHAOS_GATEWAY_CONTAINER"
    },
    "helper_a_container": {
      "type": "env",
      "key": "UBAG_CHAOS_HELPER_A_CONTAINER"
    }
  },
  "steady-states": {
    "before": {
      "title": "Gateway is ready before the fault",
      "probes": [
        {
          "type": "probe",
          "name": "gateway-ready",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${gateway_url}/v1/ready",
            "timeout": 5
          }
        }
      ]
    },
    "after": {
      "title": "Gateway is ready after the fault and recovery",
      "probes": [
        {
          "type": "probe",
          "name": "gateway-ready",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${gateway_url}/v1/ready",
            "timeout": 5
          }
        }
      ]
    }
  },
  "method": [
    {
      "type": "action",
      "name": "kill-gateway",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "kill ${gateway_container}"
      }
    },
    {
      "type": "action",
      "name": "kill-helper-a",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "kill ${helper_a_container}"
      }
    },
    {
      "type": "action",
      "name": "start-helper-a",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "start ${helper_a_container}"
      }
    },
    {
      "type": "action",
      "name": "start-gateway",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "start ${gateway_container}"
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "ensure-helper-a-running",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "start ${helper_a_container}"
      }
    },
    {
      "type": "action",
      "name": "ensure-gateway-running",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "start ${gateway_container}"
      }
    }
  ]
}
