{
  "title": "Gateway lost before the prompt is submitted",
  "description": "Kills the gateway (not the helper) while an attempt is running on helper_a and has not submitted the prompt, and restarts it after the attempt lease has lapsed. Expected: the reconciler holds the job while the old lease might still be live, then reassigns it; the new attempt takes lease generation 2 under a fresh attempt id and the old holder is fenced. The ledger shows two attempts (the first expired and never submitted) and exactly one prompt reaches the provider.",
  "tags": [
    "helper",
    "fleet",
    "reconcile",
    "gateway-restart",
    "generation"
  ],
  "status": "definition_only",
  "requires": [
    "UBAG_HELPER_NODES",
    "UBAG_HELPER_PLANE",
    "UBAG_HELPER_DISPATCH",
    "UBAG_EXECUTOR_ATTEMPTS",
    "a placer or manager adaptor wired as the HelperPicker (P4.17)",
    "two Helper Nodes (helper_a, helper_b) on a lab host that is not the shared VPS"
  ],
  "covered_by": [
    "TestReconcileGateLostBeforeSubmissionReassignsAtGenerationPlusOne",
    "TestReconcileLostBeforeSubmissionReassignsAtTheNextGenerationAndFencesTheOldHolder",
    "TestReconcilePolicyTable"
  ],
  "configuration": {
    "gateway_container": {
      "type": "env",
      "key": "UBAG_CHAOS_GATEWAY_CONTAINER"
    },
    "helper_a_container": {
      "type": "env",
      "key": "UBAG_CHAOS_HELPER_A_CONTAINER"
    }
  },
  "steady-states": {
    "before": {
      "title": "Gateway is ready before the fault",
      "probes": [
        {
          "type": "probe",
          "name": "gateway-ready",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${gateway_url}/v1/ready",
            "timeout": 5
          }
        }
      ]
    },
    "after": {
      "title": "Gateway is ready after the fault and recovery",
      "probes": [
        {
          "type": "probe",
          "name": "gateway-ready",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${gateway_url}/v1/ready",
            "timeout": 5
          }
        }
      ]
    }
  },
  "method": [
    {
      "type": "action",
      "name": "kill-gateway",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "kill ${gateway_container}"
      }
    },
    {
      "type": "action",
      "name": "wait-past-one-attempt-lease",
      "provider": {
        "type": "process",
        "path": "sleep",
        "arguments": "150"
      }
    },
    {
      "type": "action",
      "name": "start-gateway",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "start ${gateway_container}"
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "ensure-gateway-running",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "start ${gateway_container}"
      }
    }
  ]
}
