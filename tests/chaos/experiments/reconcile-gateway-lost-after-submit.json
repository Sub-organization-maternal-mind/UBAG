{
  "title": "Gateway lost after the prompt is submitted",
  "description": "Kills the gateway (not the helper) after PROMPT_SUBMITTED was committed and restarts it within the attempt lease. Expected: the restarted gateway never starts the job again. The reconciler asks helper_a (InspectAttempt), takes the attempt's lease over on the ledger and the helper, and commits the helper's outcome through the fenced ingest: the job completes. The ledger keeps exactly one attempt (submitted, then finished), the helper's browser ran once and no RunAttempt was sent after the restart.",
  "tags": [
    "helper",
    "fleet",
    "reconcile",
    "gateway-restart",
    "submission-boundary"
  ],
  "status": "definition_only",
  "requires": [
    "UBAG_HELPER_NODES",
    "UBAG_HELPER_PLANE",
    "UBAG_HELPER_DISPATCH",
    "UBAG_EXECUTOR_ATTEMPTS",
    "a placer or manager adaptor wired as the HelperPicker (P4.17)",
    "two Helper Nodes (helper_a, helper_b) on a lab host that is not the shared VPS"
  ],
  "covered_by": [
    "TestReconcileGateCollectsAFinishedAttemptAfterAGatewayRestart",
    "TestReconcileGateAdoptsARunningAttemptRenewsItAndCollectsTheOutcome",
    "TestReconcileCollectsAFinishedAttemptFromTheRealHelper",
    "TestReconcileAdoptsARunningAttemptOnTheRealHelperAndKeepsItAlive",
    "TestReconcileLostAfterSubmissionNeverRunsAndTheLedgerAgrees",
    "TestReconcileNeverRunsASubmittedAttempt"
  ],
  "configuration": {
    "gateway_container": {
      "type": "env",
      "key": "UBAG_CHAOS_GATEWAY_CONTAINER"
    },
    "helper_a_container": {
      "type": "env",
      "key": "UBAG_CHAOS_HELPER_A_CONTAINER"
    }
  },
  "steady-states": {
    "before": {
      "title": "Gateway is ready before the fault",
      "probes": [
        {
          "type": "probe",
          "name": "gateway-ready",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${gateway_url}/v1/ready",
            "timeout": 5
          }
        }
      ]
    },
    "after": {
      "title": "Gateway is ready after the fault and recovery",
      "probes": [
        {
          "type": "probe",
          "name": "gateway-ready",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${gateway_url}/v1/ready",
            "timeout": 5
          }
        }
      ]
    }
  },
  "method": [
    {
      "type": "action",
      "name": "kill-gateway",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "kill ${gateway_container}"
      }
    },
    {
      "type": "action",
      "name": "wait-inside-the-attempt-lease",
      "provider": {
        "type": "process",
        "path": "sleep",
        "arguments": "20"
      }
    },
    {
      "type": "action",
      "name": "start-gateway",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "start ${gateway_container}"
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "ensure-gateway-running",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": "start ${gateway_container}"
      }
    }
  ]
}
