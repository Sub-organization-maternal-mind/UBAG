# Copy to deploy/vps/env.local on the VPS and fill in real values there.
# env.local is gitignored — never commit real secrets.

UBAG_APP_SECRET=replace-with-a-strong-random-secret
UBAG_API_VERSION=2026-05-22
UBAG_GATEWAY_VERSION=0.0.0-vps
UBAG_BUILD_COMMIT=local
# RBAC role bound to the app-secret bearer token. One of:
# viewer | service | developer | operator | admin | superadmin.
# Empty defaults to "service" (denies Browser Sessions/Webhooks/etc via 403).
UBAG_ACTOR_ROLE=superadmin

# Required external PostgreSQL connection. URL-encode reserved password
# characters; keep the real DSN only in the gitignored env.local file.
UBAG_POSTGRES_DSN=postgres://ubag:replace-with-a-strong-random-password@postgres-host:5432/ubag?sslmode=require

# Optional overrides (sane defaults already set in docker-compose.vps.yml):
# UBAG_GATEWAY_CPUS=1.00
# UBAG_IDEMPOTENCY_TTL_HOURS=24
# UBAG_DATABASE_MAX_OPEN_CONNS=5
# UBAG_DATABASE_MAX_IDLE_CONNS=2
# UBAG_DATABASE_CONN_MAX_LIFETIME_SECONDS=300
# UBAG_WORKER_POLL_INTERVAL_MS=150
# Opt-in idle backoff for that fallback poll: doubles per empty poll up to this
# cap (ms), resets on work. Same-process enqueues still wake the loop at once.
# UBAG_WORKER_IDLE_POLL_MAX_MS=1000
# Opt-in: hardlink local-fs artifacts into the worker temp dir instead of copying.
# UBAG_ATTACHMENT_HARDLINK=true
# Opt-in: defer the warm-tab full reload while the page JS heap is under this
# budget (MB); still forced after 4x UBAG_WARM_RELOAD_EVERY jobs.
# UBAG_WARM_RELOAD_HEAP_MB=300
# UBAG_WORKER_MAX_RUNTIME_MS=1500000
# Parallel lease-process workers (default 1 = legacy serial). Raise to 2-4 for
# parallel mock/per-job execution; live warm-daemon jobs stay serial by design.
# UBAG_WORKER_CONCURRENCY=1
# Isolated warm-daemon slots (needs UBAG_WORKER_DAEMON=true; default 1 = the single
# daemon). One active job per physical browser session; a job that cannot be placed
# within the wait is returned to the queue after a short delay. The size is capped
# at UBAG_WORKER_POOL_MAX (default 3 until slot memory is measured against the 1300m
# gateway cgroup) and UBAG_WORKER_CONCURRENCY is raised to the pool size.
# UBAG_WORKER_POOL_SIZE=1
# UBAG_WORKER_POOL_MAX=3
# UBAG_WORKER_POOL_WAIT_MS=30000
# Streaming ingest (default off = batch path). The gateway applies a warm-daemon
# job's non-terminal events as they arrive and holds the single terminal until the
# worker ends cleanly; a stream that dies, ends without its marker or carries zero
# or two terminals fails the job. Live tokens also need UBAG_WORKER_STREAM_EVENTS
# on the worker, and UBAG_WORKER_STRICT_SUBMIT keeps a submitted prompt from being
# replayed. Enable the three together, after the worker was verified live.
# UBAG_WORKER_STREAM_INGEST=true
# UBAG_WORKER_STREAM_EVENTS=true
# UBAG_WORKER_STRICT_SUBMIT=true
# UBAG_WEBHOOK_SECRET=
UBAG_CONVERSATIONS_ENABLED=true
UBAG_WEBHOOK_WORKER_ENABLED=true
# Signing secret and outbound HTTPS callback allowlist must be configured
# before using webhook callbacks. Private destinations remain forbidden.
# UBAG_WEBHOOK_ALLOWED_HOSTS=callbacks.example.com

# Optional: enable per-client App JWT auth (RS256). Clients then present
# short-lived JWTs carrying tid (tenant), sub (app id), role, exp — each
# downstream app gets its own isolated (tenant, app) scope. Provide the RSA
# public key either inline (literal \n accepted) or as a mounted PEM file.
# Both unset = app-secret auth only.
# UBAG_APP_JWT_PUBLIC_KEY=
# UBAG_APP_JWT_PUBLIC_KEY_FILE=/run/secrets/appjwt-public.pem

# Optional: enable Personal Access Token issuance (POST /v1/auth/pat, superadmin
# only). Opaque ubag_pat_ bearer tokens carry a per-client (tenant, app) scope
# and persist in the gateway store, so they survive restarts on sqlite/postgres
# (the in-memory store loses them on restart). Disabled = the route returns 501.
# UBAG_PAT_ENABLED=true
# UBAG_PAT_DEFAULT_TTL_MS=  # positive integer ms; unset = issued tokens never expire by default

# Optional: bound one POST /v1/openai/chat/completions call. The facade waits
# for the backing job's terminal state up to this long, then answers 504 with
# the still-running job ID (poll GET /v1/jobs/{id} afterwards). Per-request
# ubag_wait_ms can shorten it but never exceed this cap.
# UBAG_FACADE_MAX_WAIT_MS=240000

# Antigravity (optional — enables antigravity_sdk or antigravity_cli adapter)
# UBAG_WITH_ANTIGRAVITY_SDK=true  # installs the pinned SDK only in the opted-in gateway image
# UBAG_ANTIGRAVITY_ENABLED=true
# UBAG_ANTIGRAVITY_SOCKET_DIR=/run/ubag-antigravity  # only after human sign-in and verified canary
# UBAG_ANTIGRAVITY_SLOT_1_ID=acct_1
# UBAG_ANTIGRAVITY_SLOT_2_ID=acct_2
# UBAG_ANTIGRAVITY_SLOT_3_ID=acct_3
# UBAG_ANTIGRAVITY_PROVIDER=sdk
# GEMINI_API_KEY=your_gemini_api_key_here
# UBAG_ANTIGRAVITY_MODEL=gemini-3.8-flash
# UBAG_ANTIGRAVITY_EFFORT=high
# UBAG_ANTIGRAVITY_MAX_CONCURRENT=2
# UBAG_ANTIGRAVITY_MAX_MODEL_CALLS=20
# UBAG_ANTIGRAVITY_MAX_TOOL_CALLS=50
# UBAG_ANTIGRAVITY_COMPACTION=true
# UBAG_ANTIGRAVITY_TOOL_OUTPUT_MAX_CHARS=10000
# UBAG_ANTIGRAVITY_RETRY_MAX=3

# Optional: loopback-only pprof listener (unset = no listener). Non-loopback
# hosts (e.g. ":6060", "0.0.0.0:6060") are refused. Reach it via an SSH tunnel
# or `docker exec`; never publish the port.
# UBAG_PPROF_ADDR=127.0.0.1:6060
