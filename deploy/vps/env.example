# Copy to deploy/vps/env.local on the VPS and fill in real values there.
# env.local is gitignored — never commit real secrets.

UBAG_APP_SECRET=replace-with-a-strong-random-secret
UBAG_API_VERSION=2026-05-22
UBAG_GATEWAY_VERSION=0.0.0-vps
UBAG_BUILD_COMMIT=local
# RBAC role bound to the app-secret bearer token. One of:
# viewer | service | developer | operator | admin | superadmin.
# Empty defaults to "service" (denies Browser Sessions/Webhooks/etc via 403).
UBAG_ACTOR_ROLE=superadmin

# Required external PostgreSQL connection. URL-encode reserved password
# characters; keep the real DSN only in the gitignored env.local file.
UBAG_POSTGRES_DSN=postgres://ubag:replace-with-a-strong-random-password@postgres-host:5432/ubag?sslmode=require

# Optional overrides (sane defaults already set in docker-compose.vps.yml):
# UBAG_GATEWAY_CPUS=1.00
# UBAG_IDEMPOTENCY_TTL_HOURS=24
# UBAG_DATABASE_MAX_OPEN_CONNS=5
# UBAG_DATABASE_MAX_IDLE_CONNS=2
# UBAG_DATABASE_CONN_MAX_LIFETIME_SECONDS=300
# UBAG_WORKER_POLL_INTERVAL_MS=150
# UBAG_WORKER_MAX_RUNTIME_MS=1500000
# Parallel lease-process workers (default 1 = legacy serial). Raise to 2-4 for
# parallel mock/per-job execution; live warm-daemon jobs stay serial by design.
# UBAG_WORKER_CONCURRENCY=1
# UBAG_WEBHOOK_SECRET=

# Optional: enable per-client App JWT auth (RS256). Clients then present
# short-lived JWTs carrying tid (tenant), sub (app id), role, exp — each
# downstream app gets its own isolated (tenant, app) scope. Provide the RSA
# public key either inline (literal \n accepted) or as a mounted PEM file.
# Both unset = app-secret auth only.
# UBAG_APP_JWT_PUBLIC_KEY=
# UBAG_APP_JWT_PUBLIC_KEY_FILE=/run/secrets/appjwt-public.pem

# Optional: enable Personal Access Token issuance (POST /v1/auth/pat, superadmin
# only). Opaque ubag_pat_ bearer tokens carry a per-client (tenant, app) scope
# and persist in the gateway store, so they survive restarts on sqlite/postgres
# (the in-memory store loses them on restart). Disabled = the route returns 501.
# UBAG_PAT_ENABLED=true
# UBAG_PAT_DEFAULT_TTL_MS=  # positive integer ms; unset = issued tokens never expire by default

# Optional: bound one POST /v1/openai/chat/completions call. The facade waits
# for the backing job's terminal state up to this long, then answers 504 with
# the still-running job ID (poll GET /v1/jobs/{id} afterwards). Per-request
# ubag_wait_ms can shorten it but never exceed this cap.
# UBAG_FACADE_MAX_WAIT_MS=110000
