{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ubag.dev/v1/fleet/helper-workload-manifest.schema.json",
  "title": "UBAG Helper Workload Manifest",
  "description": "What UBAG asks the external fleet manager to run on a Helper Node: the image, the non-secret environment, the one listen address, the mounts and the resource REQUESTS. The manager owns limits, firewall rules, certificate issuance and the container runtime; this file never carries a limit, a secret or a published port. Placeholders are written {{name}} and must be declared under parameters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "name", "image", "parameters", "security", "network", "env", "mounts", "resources"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "ubag-helper-workload" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "platforms"],
      "properties": {
        "repository": { "type": "string", "pattern": "^ghcr\\.io/[a-z0-9][a-z0-9._/-]*$" },
        "tag": { "type": "string", "pattern": "^\\{\\{[a-z_]+\\}\\}$", "description": "Always a placeholder: the immutable sha-<commit> tag the manager is told to pull." },
        "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["linux/amd64"] } }
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "pattern"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z_]{0,40}$" },
          "description": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1, "description": "Regular expression the manager checks the value against before substituting it." }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "read_only_root_filesystem", "no_new_privileges", "privileged", "cap_drop"],
      "properties": {
        "user": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$", "description": "Numeric non-root uid:gid." },
        "read_only_root_filesystem": { "const": true },
        "no_new_privileges": { "const": true },
        "privileged": { "const": false },
        "cap_drop": { "type": "array", "items": { "const": "ALL" }, "minItems": 1, "maxItems": 1 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "listen"],
      "properties": {
        "mode": { "const": "host", "description": "The helper binds one specific interface address and refuses a wildcard, so it runs in the host network namespace and binds the WireGuard address itself." },
        "listen": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "protocol", "address", "port"],
            "properties": {
              "name": { "const": "grpc" },
              "protocol": { "const": "tcp" },
              "address": { "const": "{{wireguard_address}}" },
              "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
            }
          }
        }
      }
    },
    "env": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "pattern": "^UBAG_HELPER_[A-Z_]+$" },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "target", "read_only"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "type": { "enum": ["bind", "volume", "tmpfs"] },
          "source": { "type": "string", "description": "A {{placeholder}} for a bind mount, a volume name for a volume, absent for tmpfs." },
          "target": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$" },
          "read_only": { "type": "boolean" }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_millis", "memory_bytes", "shm_bytes"],
          "properties": {
            "cpu_millis": { "type": "integer", "minimum": 250, "maximum": 4000 },
            "memory_bytes": { "type": "integer", "minimum": 536870912, "maximum": 8589934592 },
            "shm_bytes": { "type": "integer", "minimum": 67108864, "maximum": 2147483648, "description": "Shared memory Chromium needs; the manager applies it as the container's shm size." }
          }
        }
      }
    }
  }
}
