{
  "schema_version": "ubag.adapter.v0",
  "id": "antigravity_sdk",
  "display_name": "Antigravity SDK",
  "version": "0.2.0",
  "status": "native",
  "adapter_path": "antigravity_sdk",
  "entrypoint": "ubag_antigravity_sdk_adapter:AntigravitySDKAdapter",
  "target_homepage": "https://antigravity.google",
  "aliases": ["antigravity"],
  "login_posture": "none",
  "supported_command_types": [
    "chat.prompt", "chat.stream", "code.generate",
    "file.read", "file.write", "shell.execute"
  ],
  "capabilities": [
    "multi_turn", "file_editing", "shell_execution", "web_search",
    "code_execution", "token_usage_tracking", "compaction", "budgets",
    "tool_calls", "structured_output", "multimodal", "streaming",
    "cancellation"
  ],
  "model_catalog": {
    "settings": {
      "model": {
        "kind": "choice",
        "values": ["gemini-3.8-flash", "gemini-3.7-flash", "gemini-3.6-flash", "gemini-3.5-flash-lite"]
      },
      "effort": {
        "kind": "choice",
        "values": ["low", "medium", "high"]
      }
    }
  },
  "selector_strategy": { "type": "none", "drift_baseline_required": false },
  "artifact_policy": { "screenshots": "disabled", "dom_snapshots": "disabled", "recordings": "disabled" },
  "safe_mode": {
    "manual_login_required": false,
    "user_owned_sessions_only": true,
    "automated_login": "forbidden",
    "credential_scraping": "forbidden",
    "credential_storage": "forbidden",
    "captcha_solving": "forbidden",
    "captcha_bypass": "forbidden"
  },
  "credential_policy": {
    "collect_credentials": false, "read_credentials_from_payload": false,
    "scrape_credentials": false, "store_credentials": false
  },
  "captcha_policy": { "solve": false, "bypass": false, "delegate_to_solver": false, "manual_only": true },
  "synthetic_test_prompts": ["Say hello", "What is 2+2?"],
  "resource_policy": { "network": "required", "browser": "not_required" },
  "not_implemented_reason": ""
}
